{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@raftlab/core": ["../../packages/core/src/index.ts"],
      "@raftlab/sim": ["../../packages/sim/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
